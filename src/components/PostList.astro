---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib';

interface Props {
    posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<section>
    <div class="head">
        <h2 class="title">Selected writing</h2>
        <small class="cmd">$ ls ./posts --sort=date</small>
    </div>
    {
        posts.map((post, i) => (
            <a class="row" href={`/posts/${post.id}/`}>
                <span class="number">{String(i + 1).padStart(2, '0')}</span>
                <div>
                    <h3 class="post-title">{post.data.title}</h3>
                    <div class="meta">
                        {formatDate(post.data.date)}
                        {post.data.tags.slice(0, 3).map((t) => (
                            <span class="tag">{t}</span>
                        ))}
                    </div>
                </div>
                {post.data.cover && <img class="thumb" src={post.data.cover} alt="" loading="lazy" />}
            </a>
        ))
    }
</section>

<style>
    .head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        border-bottom: 3px solid var(--ink);
        padding-bottom: 12px;
    }

    .title {
        margin: 0;
        font-family: var(--serif);
        font-size: 34px;
        font-weight: 700;
    }

    .title::before {
        content: '';
        display: inline-block;
        width: 14px;
        height: 14px;
        margin-right: 12px;
        vertical-align: middle;
        background: var(--blue);
    }

    .cmd {
        font-size: 12px;
        color: var(--muted);
    }

    .row {
        display: grid;
        grid-template-columns: 64px 1fr 128px;
        gap: 22px;
        align-items: center;
        padding: 26px 8px;
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dashed var(--ink);
        transition: background 0.15s;
    }

    .row:hover {
        background: var(--blue-soft);
    }

    .number {
        font-family: var(--serif);
        font-size: 40px;
        font-weight: 500;
        color: var(--blue);
        opacity: 0.55;
    }

    .row:hover .number {
        opacity: 1;
    }

    .post-title {
        margin: 0 0 10px;
        font-family: var(--serif);
        font-size: 25px;
        font-weight: 700;
        line-height: 1.2;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--muted);
    }

    .thumb {
        width: 128px;
        height: 96px;
        object-fit: cover;
        border: 3px solid var(--ink);
        box-shadow: 5px 5px 0 var(--ink);
    }

    @media (max-width: 860px) {
        .title {
            font-size: 26px;
        }

        .cmd {
            display: none;
        }

        .row {
            grid-template-columns: 36px 1fr 84px;
            gap: 12px;
            padding: 20px 4px;
        }

        .number {
            font-size: 26px;
        }

        .post-title {
            font-size: 18px;
        }

        .thumb {
            width: 84px;
            height: 68px;
            box-shadow: 3px 3px 0 var(--ink);
        }
    }
</style>
