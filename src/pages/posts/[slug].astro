---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime, SITE } from '../../lib';

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags, cover, mediumUrl } = post.data;
---

<Base title={`${title} — ${SITE.name}`} description={description} image={cover} type="article" publishedTime={date.toISOString()}>
    <nav class="top">
        <a href="/" class="back">← ~/snturk</a>
        <span class="crumb">/posts/{post.id}</span>
    </nav>

    <article>
        <header class="header">
            <div class="meta">
                <time datetime={date.toISOString()}>{formatDate(date)}</time>
                <span>·</span>
                <span>{readingTime(post.body)} min read</span>
            </div>
            <h1 class="title">{title}</h1>
            <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
        </header>

        <div class="prose">
            <Content />
        </div>

        <footer class="end">
            <a class="btn primary" href="/">← all posts</a>
            {
                mediumUrl && (
                    <a class="btn" href={mediumUrl} target="_blank" rel="noreferrer">
                        also on medium ↗
                    </a>
                )
            }
        </footer>
    </article>
</Base>

<style>
    .top {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 12px;
        font-size: 13px;
        border-bottom: 3px solid var(--ink);
    }

    .back {
        font-weight: 700;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 2px solid var(--ink);
    }

    .back:hover {
        color: var(--blue);
        border-color: var(--blue);
    }

    .crumb {
        color: var(--muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    article {
        max-width: 720px;
        width: 100%;
        margin: 0 auto;
    }

    .meta {
        display: flex;
        gap: 10px;
        font-size: 13px;
        color: var(--muted);
    }

    .title {
        margin: 14px 0 18px;
        font-family: var(--serif);
        font-weight: 900;
        font-size: 56px;
        line-height: 1.05;
        letter-spacing: -0.02em;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding-bottom: 32px;
        border-bottom: 1px dashed var(--ink);
    }

    .end {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 48px;
        padding-top: 28px;
        border-top: 3px solid var(--ink);
    }

    /* Article body */
    .prose {
        font-family: var(--serif);
        font-size: 20px;
        line-height: 1.7;
    }

    .prose :global(p) {
        margin: 1.1em 0;
    }

    .prose :global(h2),
    .prose :global(h3) {
        font-family: var(--serif);
        font-weight: 700;
        line-height: 1.2;
        margin: 1.8em 0 0.4em;
    }

    .prose :global(h2) {
        font-size: 34px;
    }

    .prose :global(h3) {
        font-size: 26px;
    }

    .prose :global(h2)::before,
    .prose :global(h3)::before {
        content: '';
        display: inline-block;
        width: 10px;
        height: 10px;
        margin-right: 12px;
        vertical-align: middle;
        background: var(--blue);
    }

    .prose :global(a) {
        color: var(--blue);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }

    .prose :global(a:hover) {
        background: var(--blue-soft);
    }

    .prose :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 1.6em auto 0;
        border: 3px solid var(--ink);
        box-shadow: 6px 6px 0 var(--ink);
    }

    .prose :global(p:has(> img:only-child)) {
        margin-bottom: 0;
    }

    .prose :global(figcaption) {
        margin: 14px 0 1.6em;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--muted);
        text-align: center;
    }

    .prose :global(figcaption a) {
        color: inherit;
    }

    .prose :global(blockquote) {
        margin: 1.6em 0;
        padding: 4px 0 4px 22px;
        font-style: italic;
        border-left: 6px solid var(--blue);
    }

    .prose :global(ul),
    .prose :global(ol) {
        padding-left: 1.3em;
    }

    .prose :global(li) {
        margin: 0.4em 0;
    }

    .prose :global(code) {
        font-family: var(--mono);
        font-size: 0.82em;
        padding: 2px 6px;
        background: var(--paper-light);
        border: 1px solid var(--ink);
    }

    .prose :global(pre) {
        padding: 18px;
        overflow-x: auto;
        font-size: 15px;
        border: 3px solid var(--ink);
        box-shadow: 6px 6px 0 var(--ink);
    }

    .prose :global(pre code) {
        padding: 0;
        border: 0;
        background: none;
    }

    .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--mono);
        font-size: 14px;
    }

    .prose :global(th),
    .prose :global(td) {
        padding: 8px 10px;
        text-align: left;
        border: 2px solid var(--ink);
    }

    .prose :global(th) {
        color: #fff;
        background: var(--blue);
    }

    .prose :global(hr) {
        margin: 2.4em 0;
        border: 0;
        border-top: 1px dashed var(--ink);
    }

    @media (max-width: 860px) {
        .title {
            font-size: 36px;
        }

        .prose {
            font-size: 18px;
        }

        .prose :global(h2) {
            font-size: 26px;
        }

        .prose :global(h3) {
            font-size: 22px;
        }

        .prose :global(img) {
            box-shadow: 4px 4px 0 var(--ink);
        }
    }
</style>
